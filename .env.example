BOT_TOKEN=your_telegram_bot_token

# Docker Compose (use URL-safe characters in credentials).
POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_DB=notifications
RABBITMQ_PASSWORD=guest

# Only for running Python processes locally, outside Docker Compose.
# Compose supplies container addresses automatically.
DATABASE_URL=sqlite+aiosqlite:///./notifications.db
RABBITMQ_URL=amqp://guest:guest@localhost/
